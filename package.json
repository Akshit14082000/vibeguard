{
  "name": "vibeguard",
  "version": "0.1.0",
  "private": true,
  "description": "A focused security scanner for JavaScript/TypeScript Express applications.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
