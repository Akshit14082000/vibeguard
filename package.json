    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "bin": {
    "vibeguard": "dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
